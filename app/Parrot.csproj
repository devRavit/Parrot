<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Parrot</AssemblyName>
    <RootNamespace>Parrot</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.1</Version>
    <Product>Parrot</Product>
    <Company>Parrot</Company>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundled cursor images (populated in assets\cursors). Embedded so the single-file
         exe carries them; loaded at runtime by CursorLibrary. -->
    <EmbeddedResource Include="..\assets\cursors\*.png" Link="cursors\%(Filename)%(Extension)" />
    <!-- Native cursor-hook DLL (injected into target games/emulators) -->
    <EmbeddedResource Include="..\dist\ParrotHook64.dll" Link="ParrotHook64.dll" />
  </ItemGroup>

</Project>

